# Antimage Panel Environment Configuration

# Database
ANTIMAGE_DB_PATH=/data/antimage.db

# Server
ANTIMAGE_LISTEN=0.0.0.0:8080
ANTIMAGE_BASE_URL=https://panel.example.com

# Security
ANTIMAGE_SECRET_KEY_FILE=/config/secret.key
ANTIMAGE_SESSION_DURATION=24h
ANTIMAGE_TOTP_ISSUER=Antimage

# Logging
ANTIMAGE_LOG_LEVEL=info
ANTIMAGE_LOG_FORMAT=json

# Node Agent
ANTIMAGE_DOWNLOAD_DIR=/app/downloads

# Rate Limiting
ANTIMAGE_RATE_LIMIT_REQUESTS=1000
ANTIMAGE_RATE_LIMIT_WINDOW=1m

# Observability
ANTIMAGE_METRICS_ENABLED=true
ANTIMAGE_METRICS_PORT=9090

# CA Configuration
ANTIMAGE_CA_CERT=/config/ca.crt
ANTIMAGE_CA_KEY=/config/ca.key
