[Unit]
Description=Antimage VPN Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=antimage
Group=antimage
# Literal paths, not shell variables: systemd does not expand ${...} in a
# unit file, so this must match wherever "Option 2: Manual Installation" in
# README.md actually installs the binary and writes node.yaml.
ExecStart=/usr/local/bin/antimage-node --config /etc/antimage/node.yaml
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/antimage /var/lib/antimage
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
